## Capture the window for tools/preview.py:
##     preview OUTPUT.ppm LIBRARY [position [cell [settings]]]
## Opens the library, selects the photo at `position`, waits for thumbnails and
## the viewer's preview, then reads the frame back.
import probe
from app import LucedPhoto

pub func main(arguments: list[str]) -> int!:
    let photo = LucedPhoto(arguments[1])
    let position = int(arguments[2]) if arguments.length > 2 else 0
    let cell = float(arguments[3]) if arguments.length > 3 else 0.0
    let develop = arguments[4] if arguments.length > 4 else ""
    let guiding = arguments.length > 5 and arguments[5] == "guides"
    let expanded = arguments.length > 5 and arguments[5] == "expanded"
    let color_sections = arguments.length > 5 and arguments[5] == "color"
    let zoomed = arguments.length > 5 and arguments[5] == "zoom"
    let exporting = arguments.length > 6 and arguments[5] == "export"
    let undoing = arguments.length > 5 and arguments[5] == "undo"
    let cropping = arguments.length > 5 and arguments[5] == "crop"
    var ticks = 0
    var capture = -1
    let timer = photo.app.every(0.05, func () -> unit!:
        ticks += 1
        let grid = photo.panels.library_pane.grid
        if ticks == 4:
            if cell > 0.0:
                grid.set_cell_size(cell)
            if position < grid.item_count():
                grid.select(position)
                photo.panels.show_selection(position)
                if develop != "":
                    photo.panels.apply_develop(develop)
        if ticks == 6 and expanded:
            photo.panels.properties.develop.set_all_open(true)
        if ticks == 6 and color_sections:
            photo.panels.properties.develop.open_only(["Color Mixer", "Color Grading", "Black & White"])
        if ticks == 30 and cropping:
            photo.panels.properties.develop.set_cropping(true)
        if ticks == 40 and undoing:
            photo.panels.session.undo()
        if ticks == 10 and exporting:
            photo.panels.library_pane.grid.mark(position + 1, true)
            photo.panels.export(0, 90, 2048, arguments[6])
        if ticks == 30 and zoomed:
            photo.panels.viewer.toggle_zoom()
        if ticks == 30 and guiding:
            photo.panels.properties.develop.set_guiding(true)
        if ticks == 90 and capture < 0:
            capture = 0
        if ticks > 200:
            photo.app.stop()
        photo.panels.body.layout().invalidate())
    # The frame after `begin` is the one read back; the next ends the run.
    let observed = photo.app.on_frame(func (elapsed: float) -> unit!:
        _ = elapsed
        if capture == 0:
            capture = 1
            probe.begin("Luced Photo")
            photo.panels.body.layout().invalidate()
        elif capture == 1:
            capture = 2
            photo.app.stop())
    photo.app.run()
    observed.disconnect()
    photo.app.cancel(timer)
    probe.save(arguments[0])
    probe.end()
    photo.close()
    return 0
