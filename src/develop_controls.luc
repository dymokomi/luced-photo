## The develop's controls in the Properties pane, built from luce-develop's
## parameter table: a collapsible section per table section (White Balance,
## Exposure & Tone, Levels, Curves, Color, Color Mixer, Color Grading, Black &
## White, Lens, Geometry, Effects, View), a slider per parameter, and the few
## that are not sliders (curves, switches, the view, the guide tool). The controls edit a
## Look, luce-develop's settings object, and call `on_change` after every edit;
## `show` loads a photo's settings without calling it.
from luce_ui.ui import VStack, HStack, Text, Slider, Font, Widget, Menu, Command, Button, SectionHeader, CurveEditor, Checkbox, Spacer, Size
from interop import Connection
from luce_develop.settings import Look, look
from luce_develop import settings

## The sections in the order they show; Curves has no sliders of its own.
func section_order() -> list[str]:
    return ["White Balance", "Exposure & Tone", "Levels", "Curves", "Color", "Color Mixer", "Color Grading", "Black & White", "Lens", "Geometry", "Effects", "View"]

## The sections that start open.
func opened() -> list[str]:
    return ["White Balance", "Exposure & Tone", "Color"]

func curve_titles() -> list[str]:
    return ["RGB", "R", "G", "B", "Luma"]

## One collapsible section: its header and what it holds.
class Section:
    pub let title: str
    pub let header: SectionHeader
    pub let body: VStack
    pub var open: bool

    pub func init(self, title: str, rows: list[Widget], open: bool, font: Font) -> unit!:
        self.title = title
        self.header = SectionHeader(title, font = font)
        self.body = VStack(rows, spacing = 6.0, padding = 6.0)
        self.open = open
        self.header.set_open(open)
        self.body.layout().set_visible(open)

    pub func toggle(self):
        self.open = not self.open
        self.header.set_open(self.open)
        self.body.layout().set_visible(self.open)

pub class DevelopControls:
    pub let body: VStack
    ## The settings the controls edit.
    pub let look: Look
    let sliders: map[str, Slider]
    let sections: list[Section]
    let curves: CurveEditor
    var channel: int = 0
    let channel_name: Text
    let black_and_white: Checkbox
    let autocrop: Checkbox
    let guide_tool: Button
    ## Whether the guide tool is on.
    pub var guiding: bool = false
    ## Called when the guide tool is turned on or off, and when the guides are cleared.
    pub var on_guide_tool: func(bool) -> unit!? = none
    pub var on_guides_cleared: func() -> unit!? = none
    let view_name: Text
    var connections: list[Connection] = []
    ## The photo's as-shot white balance, which temperature 0 means.
    var shot_temperature: float = 5500.0
    var shot_tint: float = 0.0
    ## While `show` moves the controls, their changes are not the user's.
    var showing: bool = false
    pub var on_change: func() -> unit!? = none

    pub func init(self, font: Font) -> unit!:
        self.look = look("")
        self.sliders = {}
        self.sections = []
        self.channel_name = Text("RGB", font = font, muted = true)
        self.curves = CurveEditor()
        self.curves.layout().set_limits(Size(200.0, 200.0), Size(320.0, 320.0))
        self.black_and_white = Checkbox("Black & White", font = font)
        self.autocrop = Checkbox("Crop to Fit", checked = true, font = font)
        self.guide_tool = Button("Draw Guides", font = font)
        self.view_name = Text("", font = font, muted = true)
        var rows: map[str, list[Widget]] = {}
        for title in section_order():
            rows[title] = []
        for at in 0..<settings.parameter_total():
            let name = settings.name_of(at)
            let section = settings.section_of(at)
            if name == "view" or name == "bw" or name == "geometry_autocrop":
                continue
            var held = rows[section] else []
            held.append(self.slider(at, font))
            rows[section] = held
        self.add_special(rows, font)
        var widgets: list[Widget] = []
        for title in section_order():
            let section = Section(title, (rows[title] else []) + [self.reset_button(title, font)], title in opened(), font)
            self.sections.append(section)
            widgets.append(section.header)
            widgets.append(section.body)
        self.body = VStack(widgets, spacing = 2.0)

    ## The slider for table entry `at`, which sets its parameter on the look.
    func slider(self, at: int, font: Font) -> Slider!:
        let name = settings.name_of(at)
        var low = settings.low_of(at)
        var high = settings.high_of(at)
        if name == "temperature":
            low = 2000.0
            high = 12000.0
        let made = Slider(settings.label_of(at), low, high, settings.default_of(at), decimals = settings.decimals_of(at), font = font)
        self.sliders[name] = made
        self.connections.append(made.on_change(func (moved: float) -> unit!:
            if self.showing:
                return
            self.look.set(name, moved)
            # Leaving as-shot white balance keeps the as-shot value of the other.
            if name == "temperature" and self.look.get("tint") == 0.0:
                self.look.set("tint", self.shot_tint)
            if name == "tint" and self.look.get("temperature") == 0.0:
                self.look.set("temperature", self.shot_temperature)
            self.changed()))
        return made

    ## The controls that are not sliders: As Shot, the curves, the black-and-white
    ## switch and the view.
    func add_special(self, rows: map[str, list[Widget]], font: Font) -> unit!:
        let as_shot = Button("As Shot", font = font)
        self.connections.append(as_shot.on_click(func () -> unit!:
            self.look.set("temperature", 0.0)
            self.look.set("tint", 0.0)
            self.show_balance()
            self.changed()))
        rows["White Balance"] = (rows["White Balance"] else []) + [HStack([as_shot], spacing = 4.0)]
        var channels: list[Widget] = []
        for (at, title) in curve_titles().indexed():
            let button = Button(title, font = font)
            self.connections.append(button.on_click(func () -> unit!:
                self.channel = at
                self.channel_name.set_text(title)
                self.show_curve()))
            channels.append(button)
        channels.append(self.channel_name)
        self.connections.append(self.curves.on_change(func () -> unit!:
            if self.showing:
                return
            var xs: list[float] = []
            var ys: list[float] = []
            for point in 0..<self.curves.point_count():
                xs.append(self.curves.point_x(point))
                ys.append(self.curves.point_y(point))
            self.look.set_curve(self.channel, xs, ys)
            self.changed()))
        rows["Curves"] = [HStack(channels, spacing = 4.0), self.curves]
        self.connections.append(self.black_and_white.on_change(func (on: bool) -> unit!:
            if self.showing:
                return
            self.look.set("bw", 1.0 if on else 0.0)
            self.changed()))
        rows["Black & White"] = [self.black_and_white] + (rows["Black & White"] else [])
        self.connections.append(self.autocrop.on_change(func (on: bool) -> unit!:
            if self.showing:
                return
            self.look.set("geometry_autocrop", 1.0 if on else 0.0)
            self.changed()))
        self.connections.append(self.guide_tool.on_click(func () -> unit!:
            self.set_guiding(not self.guiding)))
        let clear_guides = Button("Clear Guides", font = font)
        self.connections.append(clear_guides.on_click(func () -> unit!:
            self.look.set_guides([], [], [], [])
            if let tell = self.on_guides_cleared:
                tell()
            self.changed()))
        rows["Geometry"] = [HStack([self.guide_tool, clear_guides], spacing = 4.0)] + (rows["Geometry"] else []) + [self.autocrop]
        var views: list[Command] = []
        for (at, title) in ["ACES 2.0", "Standard", "Linear"].indexed():
            let command = Command(title, id = f"view_{at}")
            self.connections.append(command.on_trigger(func () -> unit!:
                self.look.set("view", float(at))
                self.view_name.set_text(title)
                self.changed()))
            views.append(command)
        rows["View"] = [HStack([Menu("Transform", views, font = font), self.view_name], spacing = 6.0)]

    func reset_button(self, title: str, font: Font) -> Widget!:
        let button = Button("Reset", font = font)
        self.connections.append(button.on_click(func () -> unit!:
            if title == "Curves":
                for channel in 0..<5:
                    self.look.set_curve(channel, [], [])
            else:
                self.look.reset_section(title)
            self.show_values()
            self.changed()))
        return HStack([Spacer(), button], spacing = 4.0)

    ## Turn the guide tool on or off.
    pub func set_guiding(self, on: bool) -> unit!:
        if on == self.guiding:
            return
        self.guiding = on
        self.guide_tool.set_text("Done" if on else "Draw Guides")
        if let tell = self.on_guide_tool:
            tell(on)

    ## The look's guides, x1, y1, x2, y2 each.
    pub func guide_points(self) -> list[float]:
        var points: list[float] = []
        for at in 0..<self.look.guide_count():
            for end in 0..<4:
                points.append(self.look.guide(at, end))
        return points

    ## Take `points` (x1, y1, x2, y2 each) as the look's guides.
    pub func set_guide_points(self, points: list[float]) -> unit!:
        var x1s: list[float] = []
        var y1s: list[float] = []
        var x2s: list[float] = []
        var y2s: list[float] = []
        var at = 0
        while at + 3 < points.length:
            x1s.append(points[at])
            y1s.append(points[at + 1])
            x2s.append(points[at + 2])
            y2s.append(points[at + 3])
            at += 4
        self.look.set_guides(x1s, y1s, x2s, y2s)

    func changed(self) -> unit!:
        if let tell = self.on_change:
            tell()

    ## Load `text` (a photo's settings in their text form) onto the controls; the
    ## photo's as-shot balance is `shot_temperature` and `shot_tint`.
    pub func show(self, text: str, shot_temperature: float, shot_tint: float) -> unit!:
        self.look.load(text)
        self.set_shot(shot_temperature, shot_tint)

    ## The photo's as-shot white balance, known once its develop has loaded.
    pub func set_shot(self, shot_temperature: float, shot_tint: float) -> unit!:
        self.shot_temperature = shot_temperature
        self.shot_tint = shot_tint
        self.show_values()

    ## Show the look's values on the controls (after something else changed it).
    pub func show_values(self) -> unit!:
        self.showing = true
        for (name, slider) in self.sliders:
            slider.set_value(self.look.get(name))
        self.black_and_white.set_checked(self.look.get("bw") > 0.5)
        self.autocrop.set_checked(self.look.get("geometry_autocrop") > 0.5)
        self.view_name.set_text(["ACES 2.0", "Standard", "Linear"][int(self.look.get("view"))])
        self.showing = false
        self.show_balance()
        self.show_curve()

    func show_balance(self) -> unit!:
        let was = self.showing
        self.showing = true
        let as_shot = self.look.get("temperature") == 0.0
        if let temperature = self.sliders["temperature"]:
            temperature.set_value(self.shot_temperature if as_shot else self.look.get("temperature"))
        if let tint = self.sliders["tint"]:
            tint.set_value(self.shot_tint if as_shot else self.look.get("tint"))
        self.showing = was

    func show_curve(self) -> unit!:
        let was = self.showing
        self.showing = true
        var xs: list[float] = []
        var ys: list[float] = []
        for point in 0..<self.look.curve_size(self.channel):
            xs.append(self.look.curve_x(self.channel, point))
            ys.append(self.look.curve_y(self.channel, point))
        self.curves.set_points(xs, ys)
        self.showing = was

    ## Open or close sections whose headers were clicked; called on the window's timer.
    pub func tick(self):
        for section in self.sections:
            if section.header.take_click():
                section.toggle()

    pub func close(self):
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()
