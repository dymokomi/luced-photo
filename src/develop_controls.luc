## The develop's controls in the Properties pane. Each section of luce-develop's
## parameter table (White Balance, Exposure & Tone, Levels, Curves, Color, Color
## Mixer, Color Grading, Black & White, Lens, Geometry, Effects, View) is a
## luce-ui ParameterPanel with one folder heading, the same rows luced-2d and
## luced-3d use: right-aligned labels in one fixed column, a typeable field and
## an equal-length slider per number, gradient tracks where color or light helps
## to read the value, toggles, menus and buttons. Curves and Color Grading add a
## widget under their panel (the curve editor, the tone wheels), shown while the
## folder is open. The Color Mixer edits one hue band at a time: a row of chips
## picks the band, its hue, saturation and luminance show on three sliders.
##
## The controls edit a Look (luce-develop's settings) and call `on_change` after
## every edit; `show` loads a photo's settings without calling it.
from luce_ui.ui import VStack, HStack, Text, Font, Widget, ParameterPanel, ParameterSpec, ParameterKind, CurveEditor, ColorWheel, Button, Size
from luce_ui import ui
from interop import Connection
from luce_develop.settings import Look, look
from luce_develop import settings

## The label column every section shares, so all the sliders line up.
let label_width: float = 104.0

## The sections in the order they show, and those that start open.
func section_order() -> list[str]:
    return ["White Balance", "Exposure & Tone", "Levels", "Curves", "Color", "Color Mixer", "Color Grading", "Black & White", "Lens", "Geometry", "Effects", "View"]

func opened() -> list[str]:
    return ["White Balance", "Exposure & Tone", "Color"]

## The Color Mixer's bands, as the parameter names spell them, and their chips' colors.
func bands() -> list[str]:
    return ["red", "orange", "yellow", "green", "aqua", "blue", "purple", "magenta"]

func band_colors() -> list[str]:
    return ["#D23C3C", "#E0802A", "#E3C93A", "#4CAF50", "#3FBFBF", "#3B6FD8", "#8A4FD0", "#D04FA8"]

## The track a parameter's slider shows, or "" for the plain one.
func gradient_for(name: str) -> str:
    if name == "temperature":
        return "#4A7FD6|#F0F0F0|#E8A93C"
    if name == "tint":
        return "#3FA34A|#F0F0F0|#C24FBF"
    if name in ["exposure", "highlights", "shadows", "whites", "blacks", "levels_black", "levels_white", "levels_out_black", "levels_out_white", "grade_global_luminance", "grade_shadows_luminance", "grade_midtones_luminance", "grade_highlights_luminance"]:
        return "#161616|#E8E8E8"
    if name in ["saturation", "vibrance"]:
        return "#808080|#D9534F|#E3C93A|#4CAF50|#3B6FD8"
    if name.starts_with("bw_") and name != "bw_tint_hue" and name != "bw_tint_amount":
        let at = bands().index_of(name[3..]) else return ""
        return f"#202020|{band_colors()[at]}|#EFEFEF"
    if name == "bw_tint_hue":
        return "#D23C3C|#E3C93A|#4CAF50|#3FBFBF|#3B6FD8|#D04FA8|#D23C3C"
    return ""

## Parameters a section's sliders do not show: the wheels hold the grading hues
## and saturations, the mixer rows the bands', and switches and menus the rest.
func by_hand(name: str) -> bool:
    if name in ["view", "bw", "geometry_autocrop"]:
        return true
    if name.starts_with("grade_") and (name.ends_with("_hue") or name.ends_with("_saturation")):
        return true
    for band in bands():
        if name.starts_with(band + "_"):
            return true
    return false

## One section: its panel, what each row edits, and a widget under it.
class Section:
    pub let title: str
    pub let panel: ParameterPanel
    pub let names: list[str]
    pub let extra: VStack?

    pub func init(self, title: str, specs: list[ParameterSpec], extra: VStack?, font: Font) -> unit!:
        self.title = title
        self.panel = ParameterPanel(specs, font = font, label_width = label_width)
        var names: list[str] = []
        for spec in specs:
            names.append(spec.name)
        self.names = names
        self.extra = extra

    ## Row `name`'s index, or -1.
    pub func row(self, name: str) -> int:
        return self.names.index_of(name) else -1

    pub func is_open(self) -> bool:
        return self.panel.folder_open(self.title)

pub class DevelopControls:
    pub let body: VStack
    ## The settings the controls edit.
    pub let look: Look
    let sections: list[Section]
    let curves: CurveEditor
    var channel: int = 0
    let channel_name: Text
    ## The tone wheels: shadows, midtones, highlights, global.
    let wheels: list[ColorWheel]
    ## The Color Mixer's band.
    var band: int = 0
    var connections: list[Connection] = []
    ## The photo's as-shot white balance, which temperature 0 means.
    var shot_temperature: float = 5500.0
    var shot_tint: float = 0.0
    var showing: bool = false
    ## Whether the guide tool is on.
    pub var guiding: bool = false
    pub var on_change: func() -> unit!? = none
    pub var on_guide_tool: func(bool) -> unit!? = none
    pub var on_guides_cleared: func() -> unit!? = none

    pub func init(self, font: Font) -> unit!:
        self.look = look("")
        self.sections = []
        self.channel_name = Text("RGB", font = font, muted = true)
        self.curves = CurveEditor()
        self.curves.layout().set_limits(Size(200.0, 200.0), Size(320.0, 320.0))
        self.wheels = []
        var widgets: list[Widget] = []
        for title in section_order():
            let section = Section(title, self.specs_for(title), self.extra_for(title, font), font)
            self.watch(section)
            self.sections.append(section)
            widgets.append(section.panel)
            if let extra = section.extra:
                widgets.append(extra)
        self.body = VStack(widgets, spacing = 0.0)
        self.show_values()

    # mark: building ============================================================================

    ## The parameters of section `title` that are plain sliders, in table order.
    func table_rows(self, title: str) -> list[int]:
        var rows: list[int] = []
        for at in 0..<settings.parameter_total():
            if settings.section_of(at) == title and not by_hand(settings.name_of(at)):
                rows.append(at)
        return rows

    func specs_for(self, title: str) -> list[ParameterSpec]:
        var specs = [ParameterSpec(name = title, label = title, kind = ParameterKind.folder, open = title in opened())]
        if title == "Color Mixer":
            var items: list[str] = []
            for (at, band) in bands().indexed():
                items.append(f"{band.upper()[0..<1]}{band[1..]}={band_colors()[at]}")
            specs.append(ParameterSpec(name = "band", label = "Band", kind = ParameterKind.swatches, items = items.join("|"), resettable = false))
            for part in ["Hue", "Saturation", "Luminance"]:
                specs.append(ParameterSpec(name = f"mixer_{part.lower()}", label = part, minimum = -100.0, maximum = 100.0, decimals = 0, slider = true))
        for at in self.table_rows(title):
            let name = settings.name_of(at)
            specs.append(ParameterSpec(name = name, label = settings.label_of(at), value = settings.default_of(at),
                                       minimum = settings.low_of(at), maximum = settings.high_of(at),
                                       soft_minimum = 2000.0 if name == "temperature" else 0.0, soft_maximum = 12000.0 if name == "temperature" else 0.0,
                                       decimals = settings.decimals_of(at), slider = true, gradient = gradient_for(name)))
        if title == "White Balance":
            specs.append(ParameterSpec(name = "as_shot", label = "As Shot", kind = ParameterKind.button))
        if title == "Black & White":
            specs.insert(1, ParameterSpec(name = "bw", label = "Black & White", kind = ParameterKind.toggle))
        if title == "Geometry":
            specs.insert(1, ParameterSpec(name = "draw_guides", label = "Draw Guides", kind = ParameterKind.button, join = true))
            specs.insert(2, ParameterSpec(name = "clear_guides", label = "Clear Guides", kind = ParameterKind.button))
            specs.append(ParameterSpec(name = "geometry_autocrop", label = "Crop to Fit", kind = ParameterKind.toggle, value = 1.0))
        if title == "View":
            specs.append(ParameterSpec(name = "view", label = "Transform", kind = ParameterKind.menu, items = "ACES 2.0=0|Standard=1|Linear=2"))
        specs.append(ParameterSpec(name = "reset", label = "Reset", kind = ParameterKind.button, doc = f"Put {title} back as it was"))
        return specs

    ## The widget under a section: the curve editor, or the tone wheels.
    func extra_for(self, title: str, font: Font) -> VStack?!:
        if title == "Curves":
            var channels: list[Widget] = []
            for (at, caption) in ["RGB", "R", "G", "B", "Luma"].indexed():
                let button = Button(caption, font = font)
                self.connections.append(button.on_click(func () -> unit!:
                    self.channel = at
                    self.channel_name.set_text(caption)
                    self.show_curve()))
                channels.append(button)
            channels.append(self.channel_name)
            self.connections.append(self.curves.on_change(func () -> unit!:
                if self.showing:
                    return
                var xs: list[float] = []
                var ys: list[float] = []
                for point in 0..<self.curves.point_count():
                    xs.append(self.curves.point_x(point))
                    ys.append(self.curves.point_y(point))
                self.look.set_curve(self.channel, xs, ys)
                self.changed()))
            return VStack([HStack(channels, spacing = 4.0), self.curves], spacing = 6.0, padding = 8.0)
        if title == "Color Grading":
            var cells: list[Widget] = []
            for range in ["shadows", "midtones", "highlights", "global"]:
                let wheel = ColorWheel(ui.wheel_disc)
                wheel.layout().set_limits(Size(56.0, 56.0), Size(72.0, 72.0))
                self.connections.append(wheel.on_change(func () -> unit!:
                    if self.showing:
                        return
                    self.look.set(f"grade_{range}_hue", wheel.hue_value())
                    self.look.set(f"grade_{range}_saturation", wheel.saturation_value() * 100.0)
                    self.changed()))
                self.wheels.append(wheel)
                cells.append(VStack([wheel, Text(range.upper()[0..<1] + range[1..], font = font, muted = true)], spacing = 2.0))
            return VStack([HStack(cells, spacing = 6.0)], padding = 8.0)
        return none

    ## Take a section's panel edits and buttons into the look.
    func watch(self, section: Section) -> unit!:
        self.connections.append(section.panel.on_change(func (index: int) -> unit!:
            if not self.showing:
                self.take(section, index)))
        self.connections.append(section.panel.on_action(func (index: int) -> unit!:
            self.act(section, section.names[index])))

    # mark: editing =============================================================================

    func take(self, section: Section, index: int) -> unit!:
        let name = section.names[index]
        let value = section.panel.value(index)
        if name == "band":
            self.band = int(value)
            self.show_mixer(section)
            return
        if name.starts_with("mixer_"):
            self.look.set(f"{bands()[self.band]}_{name[6..]}", value)
        else:
            self.look.set(name, value)
            # Leaving as-shot white balance keeps the as-shot value of the other.
            if name == "temperature" and self.look.get("tint") == 0.0:
                self.look.set("tint", self.shot_tint)
            if name == "tint" and self.look.get("temperature") == 0.0:
                self.look.set("temperature", self.shot_temperature)
        self.changed()

    func act(self, section: Section, name: str) -> unit!:
        match name:
            "as_shot":
                self.look.set("temperature", 0.0)
                self.look.set("tint", 0.0)
            "draw_guides":
                self.set_guiding(not self.guiding)
                return
            "clear_guides":
                self.look.set_guides([], [], [], [])
                if let tell = self.on_guides_cleared:
                    tell()
            "reset":
                if section.title == "Curves":
                    for channel in 0..<5:
                        self.look.set_curve(channel, [], [])
                else:
                    self.look.reset_section(section.title)
            _:
                return
        self.show_values()
        self.changed()

    func changed(self) -> unit!:
        if let tell = self.on_change:
            tell()

    ## Turn the guide tool on or off.
    pub func set_guiding(self, on: bool) -> unit!:
        if on == self.guiding:
            return
        self.guiding = on
        for section in self.sections:
            let at = section.row("draw_guides")
            if at >= 0:
                section.panel.set_label(at, "Done" if on else "Draw Guides")
        if let tell = self.on_guide_tool:
            tell(on)

    ## The look's guides, x1, y1, x2, y2 each.
    pub func guide_points(self) -> list[float]:
        var points: list[float] = []
        for at in 0..<self.look.guide_count():
            for end in 0..<4:
                points.append(self.look.guide(at, end))
        return points

    ## Take `points` (x1, y1, x2, y2 each) as the look's guides.
    pub func set_guide_points(self, points: list[float]) -> unit!:
        var x1s: list[float] = []
        var y1s: list[float] = []
        var x2s: list[float] = []
        var y2s: list[float] = []
        var at = 0
        while at + 3 < points.length:
            x1s.append(points[at])
            y1s.append(points[at + 1])
            x2s.append(points[at + 2])
            y2s.append(points[at + 3])
            at += 4
        self.look.set_guides(x1s, y1s, x2s, y2s)

    # mark: showing =============================================================================

    ## Load `text` (a photo's settings in their text form); the photo's as-shot
    ## balance is `shot_temperature` and `shot_tint`.
    pub func show(self, text: str, shot_temperature: float, shot_tint: float) -> unit!:
        self.look.load(text)
        self.set_shot(shot_temperature, shot_tint)

    ## Load `text` keeping the photo's as-shot balance (undo, paste).
    pub func reload(self, text: str) -> unit!:
        self.look.load(text)
        self.show_values()

    ## The photo's as-shot white balance, known once its develop has loaded.
    pub func set_shot(self, shot_temperature: float, shot_tint: float) -> unit!:
        self.shot_temperature = shot_temperature
        self.shot_tint = shot_tint
        self.show_values()

    ## Put the look's values on every control.
    pub func show_values(self) -> unit!:
        self.showing = true
        for section in self.sections:
            for (index, name) in section.names.indexed():
                if name == section.title or name == "band" or name.starts_with("mixer_") or name in ["as_shot", "draw_guides", "clear_guides", "reset"]:
                    continue
                var value = self.look.get(name)
                # The white balance's default is the camera's: it shows as shot,
                # unmarked, until moved.
                if name == "temperature":
                    section.panel.set_default(index, 0, self.shot_temperature)
                    if value == 0.0:
                        value = self.shot_temperature
                if name == "tint":
                    section.panel.set_default(index, 0, self.shot_tint)
                    if self.look.get("temperature") == 0.0:
                        value = self.shot_tint
                section.panel.set_value(index, value)
            if section.title == "Color Mixer":
                self.show_mixer(section)
        for (at, range) in ["shadows", "midtones", "highlights", "global"].indexed():
            self.wheels[at].set_hsb(self.look.get(f"grade_{range}_hue"), self.look.get(f"grade_{range}_saturation") / 100.0, 1.0)
        self.showing = false
        self.show_curve()

    ## The Color Mixer's three rows for the chosen band: its values and tracks.
    func show_mixer(self, section: Section) -> unit!:
        let was = self.showing
        self.showing = true
        let band = bands()[self.band]
        let colors = band_colors()
        let color = colors[self.band]
        let before = colors[(self.band + 7) % 8]
        let after = colors[(self.band + 1) % 8]
        section.panel.set_value(section.row("band"), float(self.band))
        for (part, gradient) in [("hue", f"{before}|{color}|{after}"), ("saturation", f"#808080|{color}"), ("luminance", f"#161616|{color}|#EFEFEF")]:
            let at = section.row(f"mixer_{part}")
            section.panel.set_value(at, self.look.get(f"{band}_{part}"))
            section.panel.set_gradient(at, gradient)
        self.showing = was

    func show_curve(self) -> unit!:
        let was = self.showing
        self.showing = true
        var xs: list[float] = []
        var ys: list[float] = []
        for point in 0..<self.look.curve_size(self.channel):
            xs.append(self.look.curve_x(self.channel, point))
            ys.append(self.look.curve_y(self.channel, point))
        self.curves.set_points(xs, ys)
        self.showing = was

    ## Open or close every section.
    pub func set_all_open(self, open: bool) -> unit!:
        for section in self.sections:
            section.panel.set_folder_open(section.title, open)
        self.tick()

    ## Open only the sections named in `titles`.
    pub func open_only(self, titles: list[str]) -> unit!:
        for section in self.sections:
            section.panel.set_folder_open(section.title, section.title in titles)
        self.tick()

    ## Show each section's widget while its folder is open; called on the window's timer.
    pub func tick(self):
        for section in self.sections:
            if let extra = section.extra:
                extra.layout().set_visible(section.is_open())

    pub func close(self):
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()
