## The Recipe pane: the selected photo's recipe as a graph (recipe_view.luc),
## with its menu (Tab or a right click): add a stage the recipe lacks, start
## from a mode, and bypass, display or delete the picked stage.
from luce_ui.ui import Panel, Size, ContextMenu, Command, Font
from interop import Connection
from luce_develop.settings import Look
from luce_develop import recipe
from recipe_view import RecipeView

pub class RecipePane:
    pub let panel: Panel
    pub let view: RecipeView
    let menu: ContextMenu
    ## "Add <stage>" for every stage, in stage order.
    let adds: list[Command]
    let bypass_command: Command
    let display_command: Command
    let delete_command: Command
    var connections: list[Connection] = []

    pub func init(self, look: Look, font: Font) -> unit!:
        self.view = RecipeView(look, font)
        self.adds = []
        var commands: list[Command] = []
        for stage in 0..<recipe.stage_total():
            let command = Command(f"Add {recipe.stage_name(stage)}", id = f"recipe_add_{stage}")
            self.connections.append(command.on_trigger(func () -> unit!:
                self.view.add_at_pointer(stage)))
            self.adds.append(command)
            commands.append(command)
        commands.append(Command("", divider = true))
        for mode in 0..<recipe.mode_total():
            let command = Command(f"Start from {recipe.mode_name(mode)}", id = f"recipe_mode_{mode}")
            self.connections.append(command.on_trigger(func () -> unit!:
                self.view.use_mode(mode)))
            commands.append(command)
        commands.append(Command("", divider = true))
        self.bypass_command = Command("Bypass", id = "recipe_bypass")
        self.display_command = Command("Display", id = "recipe_display")
        self.delete_command = Command("Delete Stage", id = "recipe_delete")
        self.connections.append(self.bypass_command.on_trigger(func () -> unit!:
            self.view.toggle_bypass(self.view.picked)))
        self.connections.append(self.display_command.on_trigger(func () -> unit!:
            self.view.display(self.view.picked)))
        self.connections.append(self.delete_command.on_trigger(self.view.remove_picked))
        commands = commands + [self.bypass_command, self.display_command, self.delete_command]
        self.menu = ContextMenu(self.view, commands, font = font)
        self.connections.append(self.menu.on_open(func () -> unit!:
            self.fit_menu(look)))
        self.view.on_menu = func () -> unit!:
            self.menu.open_at(self.view.pointer_x, self.view.pointer_y)
        self.panel = Panel("Recipe", self.menu, minimum = Size(240.0, 140.0), closable = false, id = "recipe")

    ## Only stages the recipe lacks can be added; the rest act on the picked one.
    func fit_menu(self, look: Look) -> unit!:
        for (stage, command) in self.adds.indexed():
            command.set_enabled(not look.has_stage(stage))
        let picked = self.view.picked >= 0
        for command in [self.bypass_command, self.display_command, self.delete_command]:
            command.set_enabled(picked)
        if picked:
            self.bypass_command.set_checked(look.stage_bypassed(self.view.picked))
            self.display_command.set_checked(look.display_stage() == self.view.picked)

    pub func close(self):
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()
        self.menu.close()
