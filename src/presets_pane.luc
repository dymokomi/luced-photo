## The Presets pane, in the Library mode: the starts a photo begins from
## (Television, Cinema, Slide, Black & White, Super Panavision 70…: a chain of
## stages and a stock), the library's saved presets (a photo's settings, every
## stage's values), and the looks of particular pictures luce-develop documents
## ("Film · Munich (2005)"). A click gives the row to the selected photos
## (develop_session.luc says how). A saved
## preset also names the parameters the Library mode shows for its photos
## (expose_dialog.luc): asked when it is saved, changed from its menu. The
## footer saves the developed photo's settings as a new preset, saves them over
## the chosen one, renames it and deletes it; the row's menu (right-click) does
## the same for the row pressed. Presets live in the catalog (presets.lucb), so
## they travel with the library.
from luce_ui.ui import Panel, VStack, Shelf, Spacer, Size, Button, ButtonStyle, ListView, ListItem, ContextMenu, Command, TextPrompt, ConfirmDialog, Font
from interop import Connection
from photo_library import PhotoLibrary
from expose_dialog import ExposeDialog
import presets
from luce_develop import looks
import preset_marks
from luce_develop import recipe
from luce_develop import settings

pub class PresetsPane:
    pub let panel: Panel
    let library: PhotoLibrary
    let rows: ListView
    let row_menu: ContextMenu
    let prompt: TextPrompt
    let confirm: ConfirmDialog
    let apply_command: Command
    let update_command: Command
    let rename_command: Command
    let delete_command: Command
    let expose_command: Command
    pub let expose: ExposeDialog
    let font: Font
    var connections: list[Connection] = []
    ## What the prompt asks for: "save" a new preset's name or "rename" the
    ## preset with id `renaming`.
    var asking: str = ""
    var renaming: int = -1
    ## The settings a new preset takes: the photo's when Save was pressed; and its name.
    var pending: str = ""
    var pending_name: str = ""
    ## The preset whose exposed parameters the dialog edits (-1: a new one).
    var exposing: int = -1
    var deleting: int = -1
    ## The developed photo's settings as a saved preset holds them, none without one.
    pub var current: func() -> str?!? = none
    ## A row was clicked: its name, settings and the mark the photos keep of it
    ## (preset_marks.luc).
    pub var on_apply: func(str, str, int) -> unit!? = none
    pub var on_status: func(str) -> unit!? = none

    pub func init(self, library: PhotoLibrary, font: Font) -> unit!:
        self.library = library
        self.font = font
        self.rows = ListView([], font = font)
        self.rows.layout().set_flex()
        self.connections.append(self.rows.on_activate(self.apply))
        self.apply_command = Command("Apply to Selected Photos", id = "preset_apply")
        self.update_command = Command("Update with Current Settings", id = "preset_update")
        self.rename_command = Command("Rename Preset…", id = "preset_rename")
        self.delete_command = Command("Delete Preset…", id = "preset_delete")
        self.expose_command = Command("Show in Library…", id = "preset_expose")
        self.connections.append(self.expose_command.on_trigger(self.expose_chosen))
        self.expose = ExposeDialog(font)
        self.expose.chosen = self.exposed
        self.connections.append(self.apply_command.on_trigger(func () -> unit!:
            self.apply(self.rows.selected_index())))
        self.connections.append(self.update_command.on_trigger(self.update_chosen))
        self.connections.append(self.rename_command.on_trigger(self.rename_chosen))
        self.connections.append(self.delete_command.on_trigger(self.delete_chosen))
        self.row_menu = ContextMenu(self.rows, [self.apply_command, self.update_command, self.expose_command, self.rename_command, Command("", divider = true), self.delete_command], font = font)
        self.connections.append(self.row_menu.on_open(self.fit_menu))
        self.prompt = TextPrompt(font = font)
        self.connections.append(self.prompt.on_submit(self.submitted))
        self.confirm = ConfirmDialog(font = font)
        self.connections.append(self.confirm.on_choose(self.chosen_delete))
        let content = VStack([self.row_menu, self.prompt, self.confirm, self.expose.dialog], spacing = 0.0)
        content.layout().set_flex()
        let shelf = Shelf([self.shelf_button("plus", self.save_new), self.shelf_button("save", self.update_chosen),
                           self.shelf_button("text-tool", self.rename_chosen), Spacer(), self.shelf_button("trash", self.delete_chosen)])
        self.panel = Panel("Presets", content, minimum = Size(220.0, 120.0), closable = false, footer = shelf, id = "presets")
        self.show()

    func shelf_button(self, icon: str, callback: func() -> unit!) -> Button!:
        let button = Button(icon = icon, font = self.font)
        button.set_style(ButtonStyle.plain)
        self.connections.append(button.on_click(callback))
        button.layout().set_size(self.font.line_height() + 3.0, self.font.line_height() + 3.0)
        return button

    ## List the starts, the library's presets and the film looks, keeping the
    ## chosen preset chosen.
    pub func show(self, chosen_id: int = -1) -> unit!:
        let saved = self.library.presets
        var items: list[ListItem] = []
        for at in 0..<recipe.mode_total():
            items.append(ListItem(text = f"Start · {recipe.mode_name(at)}"))
        for at in 0..<saved.count():
            items.append(ListItem(text = saved.name(at)))
        for at in 0..<looks.count():
            items.append(ListItem(text = f"Film · {looks.name(at)}"))
        self.rows.set_items(items)
        if chosen_id > 0:
            self.rows.select(self.row_of(chosen_id))
        self.panel.set_text("Presets" if saved.count() == 0 else f"Presets · {saved.count()}")

    ## The rows are the starts, then the library's presets, then the film
    ## looks: row `row`'s mark (preset_marks.luc; 0 for none), and the row of
    ## mark `mark` (-1 for none).
    pub func mark_of(self, row: int) -> int:
        let saved = self.library.presets
        let modes = recipe.mode_total()
        if row >= 0 and row < modes:
            return preset_marks.for_start(row)
        if row >= modes and row < modes + saved.count():
            return saved.id(row - modes)
        if row >= modes + saved.count() and row < modes + saved.count() + looks.count():
            return preset_marks.for_look(row - modes - saved.count())
        return 0
    pub func row_of(self, mark: int) -> int:
        let saved = self.library.presets
        let modes = recipe.mode_total()
        if mark > 0:
            let found = saved.position_of(mark)
            return modes + found if found >= 0 else -1
        if preset_marks.start_of(mark) >= 0:
            return preset_marks.start_of(mark)
        if preset_marks.look_of(mark) >= 0:
            return modes + saved.count() + preset_marks.look_of(mark)
        return -1

    ## The library's preset chosen in the list (its position), or -1.
    func chosen(self) -> int:
        let mark = self.mark_of(self.rows.selected_index())
        return self.library.presets.position_of(mark) if mark > 0 else -1

    func fit_menu(self) -> unit!:
        let own = self.chosen() >= 0
        self.apply_command.set_enabled(self.rows.selected_index() >= 0)
        for command in [self.update_command, self.expose_command, self.rename_command, self.delete_command]:
            command.set_enabled(own)

    ## The developed photo's settings, or none (and why) without one.
    func current_settings(self) -> str?!:
        let ask = self.current else return none
        if let text = ask():
            return text
        self.tell("Select a photo whose settings to keep.")
        return none

    ## Stack row `at` (a start, a preset or a film look) on the selected
    ## photos, as a click does.
    pub func apply(self, at: int) -> unit!:
        let mark = self.mark_of(at)
        let tell = self.on_apply else return
        let saved = self.library.presets
        if mark > 0:
            let found = saved.position_of(mark)
            tell(saved.name(found), saved.settings(found), mark)
        elif preset_marks.start_of(mark) >= 0:
            let start = preset_marks.start_of(mark)
            tell(recipe.mode_name(start), settings.mode_text(start), mark)
        elif preset_marks.look_of(mark) >= 0:
            let look = preset_marks.look_of(mark)
            tell(looks.name(look), looks.text(look), mark)

    ## Highlight what the photo shown was last given (its mark), or nothing: a
    ## highlighted row is always the photo's own, so a click on any row shows
    ## as a change.
    pub func follow(self, mark: int) -> unit!:
        let row = self.row_of(mark)
        if row != self.rows.selected_index():
            self.rows.select(row)

    # mark: saving =============================================================================

    func save_new(self) -> unit!:
        let text = self.current_settings() else return
        self.pending = text
        self.asking = "save"
        self.prompt.open("Save the photo’s settings as the preset", self.free_name(), accept = "Next")

    func update_chosen(self) -> unit!:
        let at = self.chosen()
        if at < 0:
            self.tell("Choose one of your presets to update.")
            return
        let text = self.current_settings() else return
        let name = self.library.presets.name(at)
        let id = self.library.save_preset(name, text, self.library.presets.exposed(at))
        self.show(id)
        self.tell(f"Updated “{name}” with the photo’s settings.")

    func rename_chosen(self) -> unit!:
        let at = self.chosen()
        if at < 0:
            return
        self.asking = "rename"
        self.renaming = self.library.presets.id(at)
        self.prompt.open("Rename the preset", self.library.presets.name(at), accept = "Rename")

    func submitted(self, typed: str) -> unit!:
        let name = typed.trim()
        let asking = self.asking
        self.asking = ""
        if name == "":
            return
        if asking == "save":
            # Then which parameters the Library mode shows for it.
            self.pending_name = name
            self.exposing = -1
            let known = self.library.presets.position_of_name(name)
            let shown = self.library.presets.exposed(known) if known >= 0 else presets.default_exposed
            self.expose.open(f"Save “{name}”: what the Library shows", self.pending, shown)
        elif asking == "rename":
            let taken = self.library.presets.position_of_name(name)
            if taken >= 0 and self.library.presets.id(taken) != self.renaming:
                self.tell(f"A preset is already named “{name}”.")
                return
            self.library.rename_preset(self.renaming, name)
            self.show(self.renaming)

    ## The parameters the Library shows for the chosen preset: the dialog.
    func expose_chosen(self) -> unit!:
        let at = self.chosen()
        if at < 0:
            return
        let saved = self.library.presets
        self.exposing = saved.id(at)
        self.expose.open(f"“{saved.name(at)}”: what the Library shows", saved.settings(at), saved.exposed(at))

    ## The dialog's OK: a new preset saved, or a preset's parameters changed.
    func exposed(self, shown: str) -> unit!:
        if self.exposing >= 0:
            self.library.set_exposed(self.exposing, shown)
            self.show(self.exposing)
            self.exposing = -1
            return
        let name = self.pending_name
        let replacing = self.library.presets.position_of_name(name) >= 0
        let id = self.library.save_preset(name, self.pending, shown)
        self.show(id)
        self.tell(f"Updated “{name}”." if replacing else f"Saved the preset “{name}”.")

    ## "Preset", else "Preset 2", "Preset 3"… : a name no preset has.
    func free_name(self) -> str:
        let saved = self.library.presets
        var name = "Preset"
        var number = 2
        while saved.position_of_name(name) >= 0:
            name = f"Preset {number}"
            number += 1
        return name

    # mark: deleting ===========================================================================

    func delete_chosen(self) -> unit!:
        let at = self.chosen()
        if at < 0:
            return
        self.deleting = self.library.presets.id(at)
        self.confirm.open(f"Delete the preset “{self.library.presets.name(at)}”? Photos keep the settings it gave them.", "Delete", "")

    func chosen_delete(self, role: int) -> unit!:
        let id = self.deleting
        self.deleting = -1
        if role != 0 or id < 0:
            return
        self.library.delete_preset(id)
        self.show()

    func tell(self, text: str) -> unit!:
        if let say = self.on_status:
            say(text)

    pub func close(self):
        self.expose.close()
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()
