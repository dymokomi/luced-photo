## The Recipes pane: the modes a recipe starts from (Television, Cinema, Slide,
## Black & White, Super Panavision 70: a graph of stages and a stock), the
## library's saved recipes (a photo's recipe with every stage's values), and the
## looks of particular pictures luce-develop documents ("Film · Munich (2005)").
## A click stacks the row on the selected photos and shows its essay below the
## list
## (develop_session.luc says how): a mode replaces their recipe and stock and
## keeps their values. The footer saves the developed photo's recipe as a new
## one, saves it over the chosen one, renames it and deletes it; the row's menu
## (right-click) does the same for the row pressed. Saved recipes live in the
## catalog (recipes.lucb), so they travel with the library.
from luce_ui.ui import Text, Paragraph, Panel, VStack, Shelf, Spacer, Size, Button, ButtonStyle, ListView, ListItem, ContextMenu, Command, TextPrompt, ConfirmDialog, Font
from interop import Connection
from photo_library import PhotoLibrary
from luce_develop import looks
import essays
from luce_develop import recipe
from luce_develop import settings

pub class RecipesPane:
    pub let panel: Panel
    let library: PhotoLibrary
    let rows: ListView
    let row_menu: ContextMenu
    let prompt: TextPrompt
    let confirm: ConfirmDialog
    let apply_command: Command
    let update_command: Command
    let rename_command: Command
    let delete_command: Command
    let font: Font
    ## The clicked row's essay.
    let about_title: Text
    let about: Paragraph
    var connections: list[Connection] = []
    ## What the prompt asks for: "save" a new recipe's name or "rename" the
    ## recipe with id `renaming`.
    var asking: str = ""
    var renaming: int = -1
    ## The settings a new recipe takes: the photo's when Save was pressed.
    var pending: str = ""
    var deleting: int = -1
    ## The developed photo's settings as a saved recipe holds them, none without one.
    pub var current: func() -> str?!? = none
    ## A row was clicked: its name and settings.
    pub var on_apply: func(str, str) -> unit!? = none
    pub var on_status: func(str) -> unit!? = none

    pub func init(self, library: PhotoLibrary, font: Font) -> unit!:
        self.library = library
        self.font = font
        self.rows = ListView([], font = font)
        self.rows.layout().set_flex()
        self.connections.append(self.rows.on_activate(self.apply))
        self.apply_command = Command("Apply to Selected Photos", id = "recipe_apply")
        self.update_command = Command("Update with Current Recipe", id = "recipe_update")
        self.rename_command = Command("Rename Recipe…", id = "recipe_rename")
        self.delete_command = Command("Delete Recipe…", id = "recipe_delete")
        self.connections.append(self.apply_command.on_trigger(func () -> unit!:
            self.apply(self.rows.selected_index())))
        self.connections.append(self.update_command.on_trigger(self.update_chosen))
        self.connections.append(self.rename_command.on_trigger(self.rename_chosen))
        self.connections.append(self.delete_command.on_trigger(self.delete_chosen))
        self.row_menu = ContextMenu(self.rows, [self.apply_command, self.update_command, self.rename_command, Command("", divider = true), self.delete_command], font = font)
        self.connections.append(self.row_menu.on_open(self.fit_menu))
        self.prompt = TextPrompt(font = font)
        self.connections.append(self.prompt.on_submit(self.submitted))
        self.confirm = ConfirmDialog(font = font)
        self.connections.append(self.confirm.on_choose(self.chosen_delete))
        self.about_title = Text("", font = font)
        self.about = Paragraph("", font = font, muted = true)
        let essay = VStack([self.about_title, self.about], spacing = 6.0, padding = 6.0)
        self.about_title.layout().set_visible(false)
        self.about.layout().set_visible(false)
        let content = VStack([self.row_menu, essay, self.prompt, self.confirm], spacing = 0.0)
        content.layout().set_flex()
        let shelf = Shelf([self.shelf_button("plus", self.save_new), self.shelf_button("save", self.update_chosen),
                           self.shelf_button("text-tool", self.rename_chosen), Spacer(), self.shelf_button("trash", self.delete_chosen)])
        self.panel = Panel("Recipes", content, minimum = Size(220.0, 120.0), closable = false, footer = shelf, id = "recipes")
        self.show()

    func shelf_button(self, icon: str, callback: func() -> unit!) -> Button!:
        let button = Button(icon = icon, font = self.font)
        button.set_style(ButtonStyle.plain)
        self.connections.append(button.on_click(callback))
        button.layout().set_size(self.font.line_height() + 3.0, self.font.line_height() + 3.0)
        return button

    ## List the modes, the library's recipes and the film looks, keeping the
    ## chosen recipe chosen.
    pub func show(self, chosen_id: int = -1) -> unit!:
        let recipes = self.library.recipes
        var items: list[ListItem] = []
        for at in 0..<recipe.mode_total():
            items.append(ListItem(text = f"Mode · {recipe.mode_name(at)}"))
        for at in 0..<recipes.count():
            items.append(ListItem(text = recipes.name(at)))
        for at in 0..<looks.count():
            items.append(ListItem(text = f"Film · {looks.name(at)}"))
        self.rows.set_items(items)
        for at in 0..<recipes.count():
            if recipes.id(at) == chosen_id:
                self.rows.select(recipe.mode_total() + at)
        self.panel.set_text("Recipes" if recipes.count() == 0 else f"Recipes · {recipes.count()}")

    ## The library's recipe chosen in the list (its position), or -1.
    func chosen(self) -> int:
        let at = self.rows.selected_index() - recipe.mode_total()
        return at if at >= 0 and at < self.library.recipes.count() else -1

    func fit_menu(self) -> unit!:
        let own = self.chosen() >= 0
        self.apply_command.set_enabled(self.rows.selected_index() >= 0)
        for command in [self.update_command, self.rename_command, self.delete_command]:
            command.set_enabled(own)

    ## The developed photo's settings, or none (and why) without one.
    func current_settings(self) -> str?!:
        let ask = self.current else return none
        if let text = ask():
            return text
        self.tell("Select a photo whose settings to keep.")
        return none

    ## Stack row `at` (a mode, a recipe or a film look) on the selected
    ## photos, as a click does.
    pub func apply(self, at: int) -> unit!:
        let recipes = self.library.recipes
        let modes = recipe.mode_total()
        self.show_essay(at)
        let tell = self.on_apply else return
        if at >= 0 and at < modes:
            tell(recipe.mode_name(at), settings.mode_text(at))
        elif at >= modes and at < modes + recipes.count():
            tell(recipes.name(at - modes), recipes.settings(at - modes))
        elif at >= modes + recipes.count() and at < modes + recipes.count() + looks.count():
            let look = at - modes - recipes.count()
            tell(looks.name(look), looks.text(look))

    ## The essay of row `at`: a mode's or a look's (a saved recipe has none).
    func show_essay(self, at: int) -> unit!:
        let recipes = self.library.recipes
        let modes = recipe.mode_total()
        var key = ""
        if at >= 0 and at < modes:
            key = f"mode/{essays.slug(recipe.mode_name(at))}"
        elif at >= modes + recipes.count() and at < modes + recipes.count() + looks.count():
            key = f"look/{essays.slug(looks.name(at - modes - recipes.count()))}"
        let title = essays.essay_title(key)
        self.about_title.set_text(title.upper())
        self.about.set_text(essays.essay_text(key))
        self.about_title.layout().set_visible(title != "")
        self.about.layout().set_visible(title != "")

    # mark: saving =============================================================================

    func save_new(self) -> unit!:
        let text = self.current_settings() else return
        self.pending = text
        self.asking = "save"
        self.prompt.open("Save the photo’s recipe as", self.free_name(), accept = "Save")

    func update_chosen(self) -> unit!:
        let at = self.chosen()
        if at < 0:
            self.tell("Choose one of your recipes to update.")
            return
        let text = self.current_settings() else return
        let name = self.library.recipes.name(at)
        let id = self.library.save_recipe(name, text)
        self.show(id)
        self.tell(f"Updated “{name}” with the photo’s recipe.")

    func rename_chosen(self) -> unit!:
        let at = self.chosen()
        if at < 0:
            return
        self.asking = "rename"
        self.renaming = self.library.recipes.id(at)
        self.prompt.open("Rename the recipe", self.library.recipes.name(at), accept = "Rename")

    func submitted(self, typed: str) -> unit!:
        let name = typed.trim()
        let asking = self.asking
        self.asking = ""
        if name == "":
            return
        if asking == "save":
            let replacing = self.library.recipes.position_of_name(name) >= 0
            let id = self.library.save_recipe(name, self.pending)
            self.show(id)
            self.tell(f"Updated “{name}”." if replacing else f"Saved the recipe “{name}”.")
        elif asking == "rename":
            let taken = self.library.recipes.position_of_name(name)
            if taken >= 0 and self.library.recipes.id(taken) != self.renaming:
                self.tell(f"A recipe is already named “{name}”.")
                return
            self.library.rename_recipe(self.renaming, name)
            self.show(self.renaming)

    ## "Recipe", else "Recipe 2", "Recipe 3"… : a name no recipe has.
    func free_name(self) -> str:
        let recipes = self.library.recipes
        var name = "Recipe"
        var number = 2
        while recipes.position_of_name(name) >= 0:
            name = f"Recipe {number}"
            number += 1
        return name

    # mark: deleting ===========================================================================

    func delete_chosen(self) -> unit!:
        let at = self.chosen()
        if at < 0:
            return
        self.deleting = self.library.recipes.id(at)
        self.confirm.open(f"Delete the recipe “{self.library.recipes.name(at)}”? Photos keep the settings it gave them.", "Delete", "")

    func chosen_delete(self, role: int) -> unit!:
        let id = self.deleting
        self.deleting = -1
        if role != 0 or id < 0:
            return
        self.library.delete_recipe(id)
        self.show()

    func tell(self, text: str) -> unit!:
        if let say = self.on_status:
            say(text)

    pub func close(self):
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()
