## The Viewer: the current photo, fitted to the pane on a dark backdrop. The
## library's 2048 px preview shows at once; the photo then loads into the develop
## renderer (luce-develop), which draws it with its settings every frame, so
## every slider shows as it moves.
##
## Zoom: the photo fits the pane until zoomed. Z (the Zoom command) or a
## double-click toggles 1:1, one photo pixel to one screen pixel, about the
## pointer; command-scroll or a pinch zooms about the pointer; scrolling or
## dragging pans. Zoomed past what the viewer's develop holds, the photo loads
## again at full size in the background and swaps in.
##
## The guide tool: while it is on, the photo shows as it was taken (no
## perspective) with its guides over it. Drag on the photo to draw a guide (four
## at most), drag a guide's end to move it, right-click a guide to remove it;
## `on_guides` hears every change.
from luce_ui.ui import Widget, Layout, Size, Constraints, Event, Painter, Image, Panel, Point
from luce_gpu.gpu import RenderTarget, Rect
from luce_window.input import Cursor, EventKind
from luce_std import math
from luce_std import clock
from luce_develop.renderer import Renderer
from luce_develop import renderer
from luce_develop.settings import Look
from thumbs import Loader
import thumbs
import library
import theme

## The longer side the develop loads a photo at, in pixels.
let develop_edge: int = 2560

pub class Viewer: Widget:
    let box: Layout
    let loader: Loader
    let developer: Renderer
    pub let panel: Panel
    var picture: Image? = none
    ## The photo shown, and the one on its way (ids; -1 for none).
    var shown: int = -1
    var wanted: int = -1
    ## Called when a photo's develop is ready, with its as-shot white balance.
    pub var on_developed: func(float, float) -> unit!? = none
    ## The guide tool: whether it is on, the guides (x1, y1, x2, y2 each, 0..1 of
    ## the photo), the end being dragged (its x's index in `guides`, or -1), and
    ## where the photo was last drawn.
    pub var guiding: bool = false
    var guides: list[float] = []
    var dragging: int = -1
    var drawn: Rect = Rect(0.0, 0.0, 0.0, 0.0)
    ## Called with the guides after every change the user makes.
    pub var on_guides: func(list[float]) -> unit!? = none
    ## Zoom: 0 to fit, else points per pixel of the full-size photo, and the photo
    ## point (0..1) at the pane's middle.
    var zoom: float = 0.0
    var center_u: float = 0.5
    var center_v: float = 0.5
    ## The photo's file and full size, and whether its full-size develop is on its way.
    var original: str = ""
    var full_width: float = 0.0
    var full_height: float = 0.0
    var full_asked: bool = false
    ## Backing pixels per point and the pane's size, from the last draw.
    var backing: float = 1.0
    var pane: Size = Size(0.0, 0.0)
    ## A drag panning the photo, from (`pan_x`, `pan_y`); the last press, for double-clicks.
    var panning: bool = false
    var pan_x: float = 0.0
    var pan_y: float = 0.0
    var pressed_at: float = 0.0

    pub func init(self) -> unit!:
        self.box = Layout()
        self.box.set_cursor(Cursor.arrow)
        self.box.set_flex()
        self.box.set_limits(Size(240.0, 200.0), Size(16384.0, 16384.0))
        self.loader = thumbs.start(1, library.preview_edge)
        self.developer = renderer.start()
        self.panel = Panel("Viewer", self, minimum = Size(320.0, 240.0), closable = false, id = "viewer")

    ## Show photo `id`, `full_width` × `full_height` pixels at full size: its
    ## preview from `preview` at once, then the original at `original`, developed
    ## with the look set by `set_look`.
    pub func show(self, id: int, preview: str, original: str, full_width: int, full_height: int) -> unit!:
        if id == self.shown or id == self.wanted:
            self.box.invalidate()
            return
        self.wanted = id
        self.original = original
        self.full_width = float(full_width)
        self.full_height = float(full_height)
        self.full_asked = false
        self.zoom = 0.0
        self.center_u = 0.5
        self.center_v = 0.5
        self.loader.clear()
        self.loader.request(id, preview)
        self.developer.clear()
        self.developer.open(original, develop_edge)

    ## Develop with `look` from the next frame on.
    pub func set_look(self, look: Look) -> unit!:
        self.developer.set_look(look)
        self.box.invalidate()

    ## The histogram of the develop as shown (256 bins each of red, green, blue
    ## and luma), measured now; empty when no develop is shown.
    pub func histogram(self) -> list[int]!:
        if not self.developer.has_image():
            return []
        self.developer.compute_histogram()
        var bins: list[int] = []
        for at in 0..<1024:
            bins.append(self.developer.histogram_bin(at))
        return bins

    ## Turn the guide tool on or off, showing `guides` (x1, y1, x2, y2 each).
    pub func set_guiding(self, on: bool, guides: list[float]) -> unit!:
        self.guiding = on
        self.guides = guides
        self.dragging = -1
        self.developer.show_geometry(not on)
        self.box.set_cursor(Cursor.crosshair if on else Cursor.arrow)
        self.box.invalidate()

    ## The size of the photo the develop shows, for solving guides: 0 before it loads.
    pub func photo_width(self) -> int:
        return self.developer.width()

    pub func photo_height(self) -> int:
        return self.developer.height()

    ## Show nothing.
    pub func clear(self) -> unit!:
        self.loader.clear()
        self.developer.clear()
        self.wanted = -1
        self.shown = -1
        self.picture = none
        self.box.invalidate()

    ## Take in a finished preview or develop; called on the window's timer.
    pub func tick(self) -> unit!:
        let id = self.loader.take()
        if id >= 0 and id == self.wanted:
            let picture = Image(self.loader.taken_width(), self.loader.taken_height())
            picture.write(self.loader.taken_pixels())
            self.picture = picture
            self.shown = id
            self.wanted = -1
            self.box.invalidate()
        if self.developer.poll():
            if let tell = self.on_developed:
                tell(self.developer.shot_temperature(), self.developer.shot_tint())
            self.box.invalidate()

    pub func layout(self) -> Layout:
        return self.box

    pub func measure(self, available: Constraints) -> Size!:
        return Size(640.0, 480.0)

    pub func draw(self, target: RenderTarget) -> unit!:
        let painter = Painter(target)
        let size = target.size()
        self.backing = size.pixel_width / size.width if size.width > 0.0 else 1.0
        self.pane = Size(size.width, size.height)
        painter.rectangle(Rect(0.0, 0.0, size.width, size.height), theme.viewer_backdrop())
        if self.developer.has_image():
            let place = self.placement(float(self.developer.width()), float(self.developer.height()))
            self.drawn = place
            self.developer.draw(target, place.x, place.y, place.width, place.height)
            if self.guiding:
                self.draw_guides(painter, place)
            self.ask_full(place)
            return
        let picture = self.picture else return
        let place = self.placement(float(picture.width()), float(picture.height()))
        painter.image(picture, place)

    ## Where a `width` × `height` picture of the photo goes in the pane: fitted,
    ## or at the zoom about the center point.
    func placement(self, width: float, height: float) -> Rect:
        if self.zoom <= 0.0 or self.full_width <= 0.0:
            return fitted(self.pane.width, self.pane.height, width, height)
        let shown_width = self.full_width * self.zoom
        let shown_height = shown_width * height / width
        return Rect(self.pane.width * 0.5 - self.center_u * shown_width, self.pane.height * 0.5 - self.center_v * shown_height, shown_width, shown_height)

    ## Load the full-size develop once the zoom shows more pixels than the
    ## viewer's develop has.
    func ask_full(self, place: Rect) -> unit!:
        if self.full_asked or self.original == "":
            return
        if place.width * self.backing > float(self.developer.width()) * 1.05:
            self.full_asked = true
            self.developer.open(self.original, 0)

    ## Points per full-size pixel when fitted.
    func fit_zoom(self) -> float:
        if self.full_width <= 0.0 or self.pane.width <= 0.0:
            return 1.0
        return fitted(self.pane.width, self.pane.height, self.full_width, self.full_height).width / self.full_width

    ## Zoom to `zoom` (points per full-size pixel; 0 or less than the fit fits),
    ## keeping the photo point under (`x`, `y`) where it is.
    func zoom_to(self, zoom: float, x: float, y: float) -> unit!:
        let fit = self.fit_zoom()
        let wanted = math.min(zoom, 16.0 / self.backing)
        if wanted <= fit * 1.001:
            self.zoom = 0.0
            self.center_u = 0.5
            self.center_v = 0.5
            self.box.invalidate()
            return
        let before = self.drawn
        let u = (x - before.x) / before.width if before.width > 0.0 else 0.5
        let v = (y - before.y) / before.height if before.height > 0.0 else 0.5
        self.zoom = wanted
        # The photo point (u, v) stays under (x, y): the center moves to match.
        let width = self.full_width * wanted
        let height = width * before.height / before.width if before.width > 0.0 else width
        self.center_u = u - (x - self.pane.width * 0.5) / width
        self.center_v = v - (y - self.pane.height * 0.5) / height
        self.clamp_center()
        self.box.invalidate()

    ## Keep the photo over the pane: no empty margin while it is larger than the pane.
    func clamp_center(self):
        if self.zoom <= 0.0 or self.full_width <= 0.0:
            return
        let width = self.full_width * self.zoom
        let height = self.full_height * self.zoom
        let half_u = self.pane.width * 0.5 / width
        let half_v = self.pane.height * 0.5 / height
        self.center_u = math.max(half_u, math.min(1.0 - half_u, self.center_u)) if half_u < 0.5 else 0.5
        self.center_v = math.max(half_v, math.min(1.0 - half_v, self.center_v)) if half_v < 0.5 else 0.5

    ## Toggle between fitting the pane and 1:1, about (`x`, `y`) (the middle when negative).
    pub func toggle_zoom(self, x: float = -1.0, y: float = -1.0) -> unit!:
        let px = x if x >= 0.0 else self.pane.width * 0.5
        let py = y if y >= 0.0 else self.pane.height * 0.5
        self.zoom_to(0.0 if self.zoom > 0.0 else 1.0 / self.backing, px, py)

    ## Move the photo by (`dx`, `dy`) points.
    func pan_by(self, dx: float, dy: float):
        if self.zoom <= 0.0:
            return
        self.center_u -= dx / (self.full_width * self.zoom)
        self.center_v -= dy / (self.full_height * self.zoom)
        self.clamp_center()
        self.box.invalidate()

    func draw_guides(self, painter: Painter, place: Rect) -> unit!:
        var at = 0
        while at + 3 < self.guides.length:
            let a = Point(place.x + self.guides[at] * place.width, place.y + self.guides[at + 1] * place.height)
            let b = Point(place.x + self.guides[at + 2] * place.width, place.y + self.guides[at + 3] * place.height)
            painter.line(a, b, 3.0, theme.backdrop())
            painter.line(a, b, 1.5, theme.accent())
            for end in [a, b]:
                painter.rectangle(Rect(end.x - 4.0, end.y - 4.0, 8.0, 8.0), theme.accent())
            at += 4

    ## The index (into `guides`) of the end within 10 points of (`x`, `y`), or -1.
    func end_near(self, x: float, y: float) -> int:
        var at = 0
        while at + 1 < self.guides.length:
            let ex = self.drawn.x + self.guides[at] * self.drawn.width
            let ey = self.drawn.y + self.guides[at + 1] * self.drawn.height
            if math.abs(ex - x) <= 10.0 and math.abs(ey - y) <= 10.0:
                return at
            at += 2
        return -1

    ## The guide (its first index) passing within 8 points of (`x`, `y`), or -1.
    func guide_near(self, x: float, y: float) -> int:
        var at = 0
        while at + 3 < self.guides.length:
            let ax = self.drawn.x + self.guides[at] * self.drawn.width
            let ay = self.drawn.y + self.guides[at + 1] * self.drawn.height
            let bx = self.drawn.x + self.guides[at + 2] * self.drawn.width
            let by = self.drawn.y + self.guides[at + 3] * self.drawn.height
            let dx = bx - ax
            let dy = by - ay
            let length = dx * dx + dy * dy
            let t = math.max(0.0, math.min(1.0, ((x - ax) * dx + (y - ay) * dy) / length)) if length > 0.0 else 0.0
            let px = ax + t * dx - x
            let py = ay + t * dy - y
            if px * px + py * py <= 64.0:
                return at
            at += 4
        return -1

    func on_photo(self, x: float, y: float) -> (float, float):
        return (math.max(0.0, math.min(1.0, (x - self.drawn.x) / self.drawn.width)), math.max(0.0, math.min(1.0, (y - self.drawn.y) / self.drawn.height)))

    func tell_guides(self) -> unit!:
        if let tell = self.on_guides:
            tell(self.guides.copy())

    pub func event(self, event: Event) -> unit!:
        if self.drawn.width <= 0.0:
            return
        if event.kind == EventKind.magnify:
            self.zoom_to(math.max(self.zoom, self.fit_zoom()) * (1.0 + event.scroll_y), event.x, event.y)
            return
        if event.kind == EventKind.scroll:
            if event.meta or event.control:
                self.zoom_to(math.max(self.zoom, self.fit_zoom()) * math.pow(1.1, event.scroll_y), event.x, event.y)
            else:
                self.pan_by(event.scroll_x, event.scroll_y)
            return
        if self.panning:
            if event.kind == EventKind.pointer_moved:
                self.pan_by(event.x - self.pan_x, event.y - self.pan_y)
                self.pan_x = event.x
                self.pan_y = event.y
            elif event.kind == EventKind.pointer_up:
                self.panning = false
                self.box.set_cursor(Cursor.crosshair if self.guiding else Cursor.arrow)
            return
        if event.kind == EventKind.pointer_down and event.inside and (event.button == 2 or (event.button == 0 and not self.guiding)):
            let now = clock.timestamp()
            if event.button == 0 and now - self.pressed_at < 0.35:
                self.pressed_at = 0.0
                self.toggle_zoom(event.x, event.y)
                return
            self.pressed_at = now
            if self.zoom > 0.0:
                self.panning = true
                self.pan_x = event.x
                self.pan_y = event.y
                self.box.set_cursor(Cursor.grab)
            return
        if not self.guiding:
            return
        if event.kind == EventKind.pointer_down and event.inside:
            if event.button == 1:
                let near = self.guide_near(event.x, event.y)
                if near >= 0:
                    for _step in 0..<4:
                        _ = self.guides.remove_at(near)
                    self.box.invalidate()
                    self.tell_guides()
                return
            if event.button != 0:
                return
            let end = self.end_near(event.x, event.y)
            if end >= 0:
                self.dragging = end
                return
            if self.guides.length >= 16:
                return
            let (u, v) = self.on_photo(event.x, event.y)
            self.guides = self.guides + [u, v, u, v]
            self.dragging = self.guides.length - 2
            self.box.invalidate()
        elif event.kind == EventKind.pointer_moved and self.dragging >= 0:
            let (u, v) = self.on_photo(event.x, event.y)
            self.guides[self.dragging] = u
            self.guides[self.dragging + 1] = v
            self.box.invalidate()
        elif event.kind == EventKind.pointer_up and self.dragging >= 0:
            self.dragging = -1
            # A click without a drag leaves no guide.
            var at = 0
            while at + 3 < self.guides.length:
                let dx = (self.guides[at + 2] - self.guides[at]) * self.drawn.width
                let dy = (self.guides[at + 3] - self.guides[at + 1]) * self.drawn.height
                if dx * dx + dy * dy < 100.0:
                    for _step in 0..<4:
                        _ = self.guides.remove_at(at)
                else:
                    at += 4
            self.box.invalidate()
            self.tell_guides()

    pub func close(self):
        self.loader.close()
        self.developer.close()

## A `width` × `height` picture fitted, centred, into a `room_width` ×
## `room_height` pane with a margin; never larger than 1:1 in points.
func fitted(room_width: float, room_height: float, width: float, height: float) -> Rect:
    let margin = 16.0
    let free_width = room_width - margin * 2.0
    let free_height = room_height - margin * 2.0
    if free_width <= 0.0 or free_height <= 0.0 or width <= 0.0 or height <= 0.0:
        return Rect(0.0, 0.0, 0.0, 0.0)
    let scale = math.min(1.0, math.min(free_width / width, free_height / height))
    return Rect((room_width - width * scale) * 0.5, (room_height - height * scale) * 0.5, width * scale, height * scale)
