## Generated by tools/essays.py from essays/; edit the essays, not this file.
## The essays Properties shows under a stage's controls, by key: "stage/<key>",
## "stock/<slug>" or "process/<slug>" (essays.slug of the name).

## The slug of `name`: lower case, runs of anything but letters and digits as one "-".
pub func slug(name: str) -> str:
    var out = ""
    var gap = false
    for letter in name.lower().characters():
        if "abcdefghijklmnopqrstuvwxyz0123456789".contains(letter):
            if gap and out != "":
                out = out + "-"
            out = out + letter
            gap = false
        else:
            gap = true
    return out

## The essay title for `key`, or "".
pub func essay_title(key: str) -> str:
    match key:
        "process/bleach-bypass":
            return "Bleach bypass: leaving the silver in"
        "process/c-41":
            return "C-41: the color negative process for still film"
        "process/d-76-1-1":
            return "D-76 1:1"
        "process/d-76":
            return "D-76"
        "process/diafine":
            return "Diafine, a two-bath developer"
        "process/e-6":
            return "E-6: the reversal process"
        "process/ecn-1":
            return "ECN-1: color negative in the 1960s"
        "process/ecn-2":
            return "ECN-2: Eastman Color Negative, process 2"
        "process/hc-110-b":
            return "Kodak HC-110, dilution B"
        "process/id-11":
            return "Ilford ID-11"
        "process/microfine":
            return "Fujifilm Microfine"
        "process/microphen":
            return "Ilford Microphen"
        "process/perceptol":
            return "Ilford Perceptol"
        "process/pmk-pyro":
            return "PMK pyro"
        "process/rodinal-1-100-stand":
            return "Rodinal 1+100, stand development"
        "process/rodinal-1-25":
            return "Rodinal 1+25"
        "process/rodinal-1-50":
            return "Rodinal 1+50"
        "process/t-max-developer":
            return "Kodak T-MAX developer"
        "process/xtol-1-1":
            return "Kodak XTOL 1:1"
        "process/xtol":
            return "Kodak XTOL"
        "stage/develop":
            return "Development: making the latent image visible"
        "stage/easel":
            return "The easel: framing the picture"
        "stage/exposure":
            return "Exposure: how much light reaches the film"
        "stage/file":
            return "The file: light as the camera measured it"
        "stage/film":
            return "Film: an emulsion of silver halide"
        "stage/filter":
            return "Filters on the lens"
        "stage/grade":
            return "The grade: the colorist's tools"
        "stage/lens":
            return "The lens: light falling off toward the corners"
        "stage/lightbox":
            return "The lightbox: a slide seen directly"
        "stage/print":
            return "Printing: the negative onto print film"
        "stage/project":
            return "Projection: the print in a dark theater"
        "stage/scan":
            return "The scan: reading the negative back as light"
        "stage/view":
            return "The view: showing light on a display"
        "stage/white_balance":
