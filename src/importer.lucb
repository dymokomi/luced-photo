## The importer: copies photos into the library on its own thread, so the window
## never waits on a card or a disk. For each file under the paths it was given it
## reads the bytes, skips a file whose SHA-256 the library already holds, reads
## the metadata, copies the file to originals/YYYY/MM/DD/ by capture date, writes
## the viewer preview and the grid thumbnail, and commits the photo's row; rows
## commit a few at a time, so the grid fills in as the import goes.
##
## The window polls events, one line each, fields separated by tabs:
##     found    total                       files to look at
##     added    id  done  total  name       a photo is in the library
##     skipped  name  done  total           already in the library
##     failed   name  message  done  total  could not be imported
##     done     added  skipped  failed      the import is over
import c
import interop
import memory
import strings
import sync
import thread
import time
from luce_std import files
from luce_std import paths
from luce_prism import prism
from luce_crypto import native as crypto
from luce_develop import source
import catalog
from catalog import Photo
from luce_std.collections import Buffer, TextPool, List
import facts
import library

## How many photos each commit carries.
let commit_every: usize = 6

## What the window and the import thread share, guarded by `lock`.
struct Room:
    var lock: sync.Mutex
    var events: Buffer
    var cancelled: bool
    var finished: bool
    ## The bundle root and the paths to import, one a line; set before the start.
    var root: Buffer
    var sources: Buffer
    var store: prism.Store*?

    func post(line: const u8[]):
        self.lock.lock()
        defer self.lock.unlock()
        self.events.put(line) catch failure:
            return
        self.events.put_byte('\n') catch failure:
            return

    func drain(out: Buffer*) -> !:
        self.lock.lock()
        defer self.lock.unlock()
        try out.put(self.events.view())
        self.events.clear()

    func cancel():
        self.lock.lock()
        self.cancelled = true
        self.lock.unlock()

    func is_cancelled() -> bool:
        self.lock.lock()
        defer self.lock.unlock()
        return self.cancelled

    func finish():
        self.lock.lock()
        self.finished = true
        self.lock.unlock()

    func is_finished() -> bool:
        self.lock.lock()
        defer self.lock.unlock()
        return self.finished

    func close():
        self.events.destroy()
        self.root.destroy()
        self.sources.destroy()

## How a file went.
enum Outcome:
    added
    skipped

## The import thread's own state.
struct Job:
    var room: Room*
    var store: prism.Store*
    var root: str
    ## The library's photos before the import, for their hashes.
    var known: catalog.Rows
    ## Hashes added by this import.
    var added: List[str]
    var pool: TextPool
    var line: Buffer
    var path: Buffer
    var next: i64
    var count_added: i64
    var count_skipped: i64
    var count_failed: i64

    func close():
        self.known.close()
        self.added.destroy()
        self.pool.destroy()
        self.line.destroy()
        self.path.destroy()

    func holds(hash: str) -> bool:
        for photo in self.known.photos.view():
            if photo.sha256 == hash:
                return true
        for kept in self.added.view():
            if kept == hash:
                return true
        return false

## The import thread: import every file the room names, then report.
func serve(context: void*?):
    let room = (Room*)(context else return)
    work(room) catch failure:
        var line: Buffer
        defer line.destroy()
        line.put(b"error\t") catch dropped:
            _ = dropped
        put_field(&line, failure.message.bytes) catch dropped:
            _ = dropped
        room.post(line.view())
    room.finish()

func work(room: Room*) -> !:
    let store = room.store else error(prism.closed, "the importer has no catalog")
    var job = Job(room = room, store = store, root = room.root.text(), known = try catalog.read(store))
    defer job.close()
    job.next = job.known.next
    try library.ensure(job.root)
    var found: List[str]
    defer found.destroy()
    var names: TextPool
    defer names.destroy()
    try gather(room.sources.text(), job.root, &found, &names)
    job.line.clear()
    try job.line.put(b"found\t")
    try job.line.put_number((i64)found.length())
    room.post(job.line.view())
    var batch = try catalog.Batch.begin(store)
    defer batch.close()
    # "added" lines wait here until their rows are committed, so the window can read them.
    var pending: Buffer
    defer pending.destroy()
    for (done, file) in found.view().indexed():
        if room.is_cancelled():
            break
        job.line.clear()
        let outcome = import_one(&job, file, &batch) catch failure:
            job.count_failed += 1
            try job.line.put(b"failed\t")
            try put_field(&job.line, paths.base(file).bytes)
            try job.line.put_byte('\t')
            try put_field(&job.line, failure.message.bytes)
            try progress(&job, done + 1, found.length())
            room.post(job.line.view())
            continue
        if outcome == Outcome.skipped:
            job.count_skipped += 1
            try job.line.put(b"skipped\t")
            try put_field(&job.line, paths.base(file).bytes)
            try progress(&job, done + 1, found.length())
            room.post(job.line.view())
            continue
        job.count_added += 1
        try pending.put(b"added\t")
        try pending.put_number(job.next - 1)
        try progress_into(&pending, done + 1, found.length())
        try pending.put_byte('\t')
        try put_field(&pending, paths.base(file).bytes)
        try pending.put_byte('\n')
        if batch.count >= commit_every:
            try batch.flush(store)
            try post_lines(room, &pending)
    try batch.commit()
    try post_lines(room, &pending)
    try catalog.bake(store)
    job.line.clear()
    try job.line.put(b"done\t")
    try job.line.put_number(job.count_added)
    try job.line.put_byte('\t')
    try job.line.put_number(job.count_skipped)
    try job.line.put_byte('\t')
    try job.line.put_number(job.count_failed)
    room.post(job.line.view())

func progress(job: Job*, done: usize, total: usize) -> !:
    try progress_into(&job.line, done, total)

func progress_into(line: Buffer*, done: usize, total: usize) -> !:
    try line.put_byte('\t')
    try line.put_number((i64)done)
    try line.put_byte('\t')
    try line.put_number((i64)total)

## Post every line of `pending` and empty it.
func post_lines(room: Room*, pending: Buffer*) -> !:
    if pending.length() == 0:
        return
    # Without its last newline: post adds one.
    room.post(pending.view()[..<pending.length() - 1])
    pending.clear()

## Every photo file named in `sources` (one path a line): files as they are,
## folders walked, files inside the library at `root` left out.
func gather(sources: str, root: str, found: List[str]*, names: TextPool*) -> !:
    var first: usize = 0
    let text = sources.bytes
    while first < text.length:
        var end = first
        while end < text.length and text[end] != '\n':
            end += 1
        let path = (str)text[first..<end]
        first = end + 1
        if path.length == 0 or path.bytes.length >= root.length and (str)path.bytes[..<root.length] == root:
            continue
        let terminated = try strings.copy(path)
        defer strings.release(terminated)
        let stat = files.metadata((c.str)terminated) catch failure:
            continue
        if stat.kind == files.FileKind.directory:
            let entries = try files.walk((c.str)terminated)
            defer entries.release()
            for entry in entries.value:
                if source.is_photo_name(entry):
                    let joined = try paths.join(path, entry)
                    defer joined.release()
                    try found.append(try names.keep_text(joined.value.bytes))
        elif source.is_photo_name(path):
            try found.append(try names.keep_text(path.bytes))

## Import the file at `file`, adding its row to `batch`.
func import_one(job: Job*, file: str, batch: catalog.Batch*) -> Outcome!:
    let terminated = try strings.copy(file)
    defer strings.release(terminated)
    let data = try files.read((c.str)terminated)
    defer data.release()
    let found = source.kind(data.value)
    if found == source.Kind.unknown:
        error(source.unsupported, "not a photo luced-photo reads")
    var digest: u8[32]
    _ = try crypto.digest(data.value, digest, "sha256")
    var hex: u8[64]
    for (at, byte) in digest.indexed():
        hex[at * 2] = hex_digit(byte >> 4)
        hex[at * 2 + 1] = hex_digit(byte & 15)
    if job.holds((str)hex[0..]):
        return .skipped
    var photo = Photo(id = job.next, imported = time.unix())
    photo.sha256 = try job.pool.keep_text(hex)
    try facts.describe(file, data.value, found, &photo, &job.pool)
    # The original, by capture date: originals/YYYY/MM/DD/name, numbered on a clash.
    var relative: Buffer
    defer relative.destroy()
    try relative.put(b"originals/")
    try relative.put(photo.captured.bytes[0..<4])
    try relative.put_byte('/')
    try relative.put(photo.captured.bytes[5..<7])
    try relative.put_byte('/')
    try relative.put(photo.captured.bytes[8..<10])
    try library.join_into(job.root, relative.text(), &job.path)
    try files.ensure_directory(job.path.text())
    try relative.put_byte('/')
    try place(job, &relative, photo.name)
    photo.path = try job.pool.keep_text(relative.view())
    try library.join_into(job.root, photo.path, &job.path)
    try files.write_atomic(try job.path.terminated(), data.value)
    # The viewer's preview and the grid's thumbnail.
    var preview = try source.preview(data.value, (usize)library.preview_edge, (u64)photo.orientation)
    defer preview.close()
    if photo.width == 0:
        photo.width = preview.width()
        photo.height = preview.height()
    try library.cache_path(job.root, "previews", photo.id, &job.path)
    try preview.save_jpeg(job.path.text(), 88)
    var thumb = try preview.shrunk((usize)library.thumb_edge)
    defer thumb.close()
    try library.cache_path(job.root, "thumbs", photo.id, &job.path)
    try thumb.save_jpeg(job.path.text(), 82)
    try batch.put(&photo)
    try job.added.append(photo.sha256)
    job.next += 1
    try batch.set_next(job.next)
    return .added

## Append to `relative` (a folder, ending in /) a file name for `name` not yet
## taken there: the name itself, else name-2.ext, name-3.ext…
func place(job: Job*, relative: Buffer*, name: str) -> !:
    let folder = relative.length()
    let stem = paths.stem(name)
    let extension = paths.extension(name)
    var attempt: i64 = 1
    while true:
        relative.truncate(folder)
        try relative.put_text(stem)
        if attempt > 1:
            try relative.put_byte('-')
            try relative.put_number(attempt)
        try relative.put_text(extension)
        try library.join_into(job.root, relative.text(), &job.path)
        if not files.exists(try job.path.terminated()):
            return
        attempt += 1

## Append `data` as one tab-separated field: tabs and line breaks inside it become
## spaces, so the window may split event lines at tabs.
func put_field(out: Buffer*, data: const u8[]) -> !:
    for byte in data:
        try out.put_byte(' ' if byte == '\t' or byte == '\n' or byte == '\r' else byte)

func hex_digit(value: u8) -> u8:
    return value + '0' if value < 10 else value - 10 + 'a'

## A running import.
pub struct Importer:
    var room: Room*?
    var handle: thread.Handle
    ## Keeps the catalog the thread writes open until the thread has stopped.
    var store: interop.Reference[prism.Store]?
    var polled: Buffer

    ## The events since the last poll, one a line; empty when there are none.
    pub func poll() -> str!:
        self.polled.clear()
        let room = self.room else return ""
        try room.drain(&self.polled)
        return self.polled.text()

    ## Whether the import is over (its last events may still wait for a poll).
    pub func finished() -> bool:
        let room = self.room else return true
        return room.is_finished()

    ## Stop after the file being imported; what is in the library stays.
    pub func cancel():
        if let room = self.room:
            room.cancel()

    ## Stop the import and wait for its thread.
    pub func close():
        let room = self.room else return
        room.cancel()
        self.handle.join() catch failure:
            trap("the import thread could not be joined")
        room.close()
        free(room) in memory.heap
        self.room = none
        self.polled.destroy()
        if let held = self.store:
            held.release()
        self.store = none

pub let importer_type: interop.Type[Importer] = interop.Type[Importer]("Importer", Importer.close, closeable = true, main_thread = true)

## Import the photo files and folders `sources` into the library bundle at
## `root`, whose catalog is `store`, on a thread of its own.
pub func start(store: interop.Reference[prism.Store], root: str, sources: const str[]) -> interop.Reference[Importer]!:
    let room = try new Room in memory.heap
    errdefer free(room) in memory.heap
    try room.root.put_text(root)
    for path in sources:
        try room.sources.put_text(path)
        try room.sources.put_byte('\n')
    room.store = try store.get()
    let handle = try thread.spawn(serve, (void*)room, name = "luced-photo import")
    let importer = try new Importer(room = room, handle = handle, store = store.clone()) in memory.heap
    return try interop.Reference[Importer].adopt(importer, importer_type, memory.heap)
