## One Command per action, as in luced-2d: menus, toolbar buttons, the command
## palette and the keyboard all present the same command. Rating, flag and label
## keys are single keys, as in Lightroom and Capture One: 0–5 stars, P pick,
## X reject, U clear the flag, 6–9 red, yellow, green and blue labels.
from luce_ui.ui import Command, Shortcut
from luce_window.input import Key
import modes

pub class Actions:
    # Library
    pub let new_library: Command
    pub let open_library: Command
    pub let import_photos: Command
    pub let import_folder: Command
    pub let export_photos: Command
    pub let select_all: Command
    pub let bigger: Command
    pub let smaller: Command
    # Marks
    pub let ratings: list[Command]
    pub let pick: Command
    pub let reject: Command
    pub let unflag: Command
    pub let labels: list[Command]
    pub let next: Command
    pub let previous: Command
    ## The viewer: fit the pane, or 1:1; and watching the film develop.
    pub let zoom: Command
    pub let before_after: Command
    pub let watch_development: Command
    pub let refine_grain: Command
    # The develop
    pub let undo: Command
    pub let redo: Command
    pub let copy_settings: Command
    pub let paste_settings: Command
    pub let copy_film: Command
    pub let move_to_trash: Command
    ## Forward Delete does what ⌫ does (a command has one key; this one is in no menu).
    pub let move_to_trash_forward: Command
    pub let put_back: Command
    pub let paste_film: Command
    pub let sync_settings: Command
    pub let reset_settings: Command
    ## The modes (modes.luc), ⌘1 to ⌘5.
    pub let modes: list[Command]
    # Application
    pub let palette: Command
    pub let reset_layout: Command
    pub let quit: Command
    ## Every command, for the application's registry and the palette.
    pub let all: list[Command]

    pub func init(self) -> unit!:
        self.new_library = Command("New Library…", Shortcut(Key.n, primary = true, shift = true), id = "new_library")
        self.open_library = Command("Open Library…", Shortcut(Key.o, primary = true), id = "open_library")
        self.import_photos = Command("Import Photos…", Shortcut(Key.i, primary = true, shift = true), id = "import")
        self.import_folder = Command("Import Folder…", Shortcut(Key.o, primary = true, shift = true), id = "import_folder")
        self.export_photos = Command("Export…", Shortcut(Key.e, primary = true, shift = true), id = "export")
        self.select_all = Command("Select All", Shortcut(Key.a, primary = true), id = "select_all")
        self.bigger = Command("Larger Thumbnails", Shortcut(Key.equal, primary = true), id = "bigger")
        self.smaller = Command("Smaller Thumbnails", Shortcut(Key.minus, primary = true), id = "smaller")
        let digits = [Key.digit_0, Key.digit_1, Key.digit_2, Key.digit_3, Key.digit_4, Key.digit_5]
        self.ratings = []
        for (stars, key) in digits.indexed():
            let title = "No Rating" if stars == 0 else ("★".repeat(stars))
            self.ratings.append(Command(title, Shortcut(key), id = f"rate_{stars}"))
        self.pick = Command("Pick", Shortcut(Key.p), id = "pick")
        self.reject = Command("Reject", Shortcut(Key.x), id = "reject")
        self.unflag = Command("Unflag", Shortcut(Key.u), id = "unflag")
        self.labels = [Command("Red Label", Shortcut(Key.digit_6), id = "label_red"),
                       Command("Yellow Label", Shortcut(Key.digit_7), id = "label_yellow"),
                       Command("Green Label", Shortcut(Key.digit_8), id = "label_green"),
                       Command("Blue Label", Shortcut(Key.digit_9), id = "label_blue"),
                       Command("No Label", id = "label_none")]
        self.next = Command("Next Photo", Shortcut(Key.right, primary = true), id = "next")
        self.previous = Command("Previous Photo", Shortcut(Key.left, primary = true), id = "previous")
        self.zoom = Command("Zoom to Fit / 1:1", Shortcut(Key.z), id = "zoom")
        self.before_after = Command("Before / After", Shortcut(Key.y), id = "before_after")
        self.watch_development = Command("Watch Development", Shortcut(Key.d, shift = true), id = "watch_development")
        self.refine_grain = Command("Render Grain", Shortcut(Key.g, shift = true), id = "refine_grain")
        self.refine_grain.set_checked(true)
        self.undo = Command("Undo", Shortcut(Key.z, primary = true), id = "undo")
        self.redo = Command("Redo", Shortcut(Key.z, primary = true, shift = true), id = "redo")
        self.copy_settings = Command("Copy Settings", Shortcut(Key.c, primary = true, shift = true), id = "copy_settings")
        self.paste_settings = Command("Paste Settings", Shortcut(Key.v, primary = true, shift = true), id = "paste_settings")
        self.move_to_trash = Command("Move to Trash", Shortcut(Key.backspace), id = "move_to_trash")
        self.move_to_trash_forward = Command("Move to Trash", Shortcut(Key.delete), id = "move_to_trash_forward")
        self.put_back = Command("Put Back", id = "put_back")
        self.copy_film = Command("Copy Film Preset", Shortcut(Key.c, primary = true, alt = true), id = "copy_film")
        self.paste_film = Command("Paste Film Preset", Shortcut(Key.v, primary = true, alt = true), id = "paste_film")
        self.sync_settings = Command("Sync Settings to Selection", Shortcut(Key.s, primary = true, shift = true), id = "sync_settings")
        self.reset_settings = Command("Reset Settings", Shortcut(Key.r, primary = true, shift = true), id = "reset_settings")
        let mode_keys = [Key.digit_1, Key.digit_2, Key.digit_3, Key.digit_4, Key.digit_5]
        self.modes = []
        for (at, key) in mode_keys.indexed():
            self.modes.append(Command(modes.name(at), Shortcut(key, primary = true), id = f"mode_{modes.name(at).lower()}"))
        self.palette = Command("Command Palette…", Shortcut(Key.p, primary = true, shift = true), id = "palette")
        self.reset_layout = Command("Reset Layout", id = "reset_layout")
        self.quit = Command("Quit", Shortcut(Key.q, primary = true), id = "quit")
        self.all = [self.new_library, self.open_library, self.import_photos, self.import_folder, self.export_photos, self.select_all, self.bigger, self.smaller] + self.ratings
        self.all = self.all + [self.pick, self.reject, self.unflag] + self.labels
        self.all = self.all + [self.next, self.previous, self.zoom, self.before_after, self.watch_development, self.refine_grain, self.undo, self.redo, self.copy_settings, self.paste_settings,
                               self.copy_film, self.paste_film, self.move_to_trash, self.move_to_trash_forward, self.put_back, self.sync_settings, self.reset_settings] + self.modes + [self.palette, self.reset_layout, self.quit]

    ## Enable the actions on photos when some are selected.
    pub func refresh(self, has_photo: bool) -> unit!:
        for command in self.ratings + self.labels + [self.pick, self.reject, self.unflag, self.export_photos]:
            command.set_enabled(has_photo)

## The label number (1–7, see luce-ui's label_color) of `labels[at]`; 0 for No Label.
pub func label_number(at: int) -> int:
    return [1, 3, 4, 5, 0][at]
