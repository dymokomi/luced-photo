## One Command per action, as in luced-2d: menus, toolbar buttons, the command
## palette and the keyboard all present the same command. Rating, flag and label
## keys are single keys, as in Lightroom and Capture One: 0–5 stars, P pick,
## X reject, U clear the flag, 6–9 red, yellow, green and blue labels.
from luce_ui.ui import Command, Shortcut
from luce_window.input import Key

pub class Actions:
    # Library
    pub let import_photos: Command
    pub let select_all: Command
    pub let bigger: Command
    pub let smaller: Command
    # Marks
    pub let ratings: list[Command]
    pub let pick: Command
    pub let reject: Command
    pub let unflag: Command
    pub let labels: list[Command]
    pub let next: Command
    pub let previous: Command
    ## The viewer: fit the pane, or 1:1.
    pub let zoom: Command
    # Application
    pub let palette: Command
    pub let reset_layout: Command
    pub let quit: Command
    ## Every command, for the application's registry and the palette.
    pub let all: list[Command]

    pub func init(self) -> unit!:
        self.import_photos = Command("Import Photos…", Shortcut(Key.i, primary = true, shift = true), id = "import")
        self.select_all = Command("Select All", Shortcut(Key.a, primary = true), id = "select_all")
        self.bigger = Command("Larger Thumbnails", Shortcut(Key.equal, primary = true), id = "bigger")
        self.smaller = Command("Smaller Thumbnails", Shortcut(Key.minus, primary = true), id = "smaller")
        let digits = [Key.digit_0, Key.digit_1, Key.digit_2, Key.digit_3, Key.digit_4, Key.digit_5]
        self.ratings = []
        for (stars, key) in digits.indexed():
            let title = "No Rating" if stars == 0 else ("★".repeat(stars))
            self.ratings.append(Command(title, Shortcut(key), id = f"rate_{stars}"))
        self.pick = Command("Pick", Shortcut(Key.p), id = "pick")
        self.reject = Command("Reject", Shortcut(Key.x), id = "reject")
        self.unflag = Command("Unflag", Shortcut(Key.u), id = "unflag")
        self.labels = [Command("Red Label", Shortcut(Key.digit_6), id = "label_red"),
                       Command("Yellow Label", Shortcut(Key.digit_7), id = "label_yellow"),
                       Command("Green Label", Shortcut(Key.digit_8), id = "label_green"),
                       Command("Blue Label", Shortcut(Key.digit_9), id = "label_blue"),
                       Command("No Label", id = "label_none")]
        self.next = Command("Next Photo", Shortcut(Key.right, primary = true), id = "next")
        self.previous = Command("Previous Photo", Shortcut(Key.left, primary = true), id = "previous")
        self.zoom = Command("Zoom to Fit / 1:1", Shortcut(Key.z), id = "zoom")
        self.palette = Command("Command Palette…", Shortcut(Key.p, primary = true, shift = true), id = "palette")
        self.reset_layout = Command("Reset Layout", id = "reset_layout")
        self.quit = Command("Quit", Shortcut(Key.q, primary = true), id = "quit")
        self.all = [self.import_photos, self.select_all, self.bigger, self.smaller] + self.ratings
        self.all = self.all + [self.pick, self.reject, self.unflag] + self.labels
        self.all = self.all + [self.next, self.previous, self.zoom, self.palette, self.reset_layout, self.quit]

    ## Enable the actions on photos when some are selected.
    pub func refresh(self, has_photo: bool) -> unit!:
        for command in self.ratings + self.labels + [self.pick, self.reject, self.unflag]:
            command.set_enabled(has_photo)

## The label number (1–7, see luce-ui's label_color) of `labels[at]`; 0 for No Label.
pub func label_number(at: int) -> int:
    return [1, 3, 4, 5, 0][at]
